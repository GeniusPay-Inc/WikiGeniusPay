# Application
APP_NAME="GeniusPay Wiki"
APP_URL=https://wiki.geniuspay.ci

# Base de données PostgreSQL
DB_HOST=wiki-db
DB_PORT=5432
DB_DATABASE=geniuspay_wiki
DB_USERNAME=geniuspay
DB_PASSWORD=change-me

# n8n
N8N_HOST=n8n.geniuspay.ci
N8N_WEBHOOK_URL=https://wiki.geniuspay.ci/webhook

# LLM (génération de réponse — Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-5

# Embeddings (indexation & recherche vectorielle — OpenAI, 1536 dimensions)
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Backoffice
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me
